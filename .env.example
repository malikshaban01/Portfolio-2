# Copy this file to .env and fill in the values.

# Contact form endpoint (free): create a form at https://formspree.io
# then paste its endpoint below. Without it, the form falls back to mailto.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Archived backend/admin only (see archive/) — not used by the static build.
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
