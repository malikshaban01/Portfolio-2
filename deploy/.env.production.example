# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables for the EC2 instance.
#
# Copy this file to /var/www/portfolio/.env on the server and fill in the
# values, then run:  pm2 restart portfolio
#
# Get these from your Supabase dashboard: Project Settings > API
# ─────────────────────────────────────────────────────────────────────────────

# Used by the API routes at runtime (server-side).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: only needed by api/db-wake.js to auto-restore a paused Supabase
# project. Leave blank to disable.
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND BUILD VARS — read at `npm run build` time, baked into the bundle.
# Add these to the same .env before building, OR export them in the shell
# that runs the build:
#   export VITE_SUPABASE_URL=...  &&  export VITE_SUPABASE_ANON_KEY=...
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
